[Unit]
Description=MonsoonReady: keep the UNO Q checkout in step with the repo
Documentation=https://github.com/doggylover314/monsoonready-drone
# Without network-online the unit starts before DHCP finishes and the first
# several fetches fail for no reason. They would recover, but the log then
# opens with errors that look like a broken setup.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arduino
WorkingDirectory=/home/arduino/monsoonready
ExecStart=/home/arduino/monsoonready/uno_q/deploy/board_sync.sh

# The script exits 0 on purpose when it pulls a new version of ITSELF, so
# always-restart is what makes self-update work rather than a failure policy.
Restart=always
RestartSec=5

# It only ever reads the network and writes the checkout. Nothing here needs
# root, raw devices, or anything outside the home directory.
#
# IF THE SERVICE FAILS WITH A PERMISSION ERROR, these four lines are the first
# suspects and dropping them costs nothing but hardening: git occasionally
# wants to write outside the checkout (a credential cache, a global lock).
# journalctl -u monsoonready-sync will name the path it was refused.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/arduino/monsoonready

[Install]
WantedBy=multi-user.target
