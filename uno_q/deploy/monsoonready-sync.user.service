[Unit]
# USER-LEVEL variant of monsoonready-sync.service. Identical behaviour, but it
# installs under ~/.config/systemd/user/ and is managed with `systemctl --user`,
# so it needs NO ROOT AND NO SUDO PASSWORD.
#
# Written 2026-08-11 because the board's sudo password was forgotten four days
# before the deadline. Reflashing to recover root would have cost the whole
# board setup; nothing this service does actually requires privilege, so the
# root requirement was never real in the first place.
#
# DIFFERENCES FORCED BY USER SCOPE, not preferences:
#   * no User=          - a user unit already runs as that user by definition,
#                         and setting User= makes systemd refuse to load it
#   * no ProtectHome    - the home directory IS the working area here, and the
#                         sandboxing directives in the system unit are only
#                         meaningful when the alternative is running as root
#   * default.target    - user units have no multi-user.target
#
# SURVIVING REBOOT: a user service normally stops when the last session of that
# user ends. `loginctl enable-linger arduino` fixes that, but may itself ask for
# authentication. If it does, use the crontab route in deploy/README.md instead,
# which needs no privilege of any kind.
Description=MonsoonReady: keep the UNO Q checkout in step with the repo (user scope)
Documentation=https://github.com/doggylover314/monsoonready-drone
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/monsoonready
ExecStart=%h/monsoonready/uno_q/deploy/board_sync.sh

# The script exits 0 on purpose when it pulls a new version of ITSELF, so
# always-restart is what makes self-update work rather than a failure policy.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
