# =============================================================================
#  ardupilot_proximity.param
#
#  ArduPilot Copter parameters to accept the ESP32's MAVLink OBSTACLE_DISTANCE
#  feed on TELEM2 and use it for obstacle avoidance.
#
#  Values verified against ArduPilot Copter 4.5 source (cross-checked vs master
#  / 4.6). Load in Mission Planner: CONFIG > Full Parameter List > Load from
#  file, then Write Params, then REBOOT (SERIAL2_PROTOCOL and PRX1_TYPE only
#  expose their sub-parameters after a reboot).
#
#  Assumes the ESP32 is wired to TELEM2 (= SERIAL2 on standard Pixhawk/Cube).
#  If you used a different port, change the SERIALx_ prefix accordingly.
#
#  Format is NAME,VALUE (Mission Planner). '#' lines are comments.
# =============================================================================

# --- Serial port (TELEM2 = SERIAL2) ---
SERIAL2_PROTOCOL,2        # 2 = MAVLink2  (must speak MAVLink to parse OBSTACLE_DISTANCE)
SERIAL2_BAUD,115          # 115 = 115200 baud  (MUST equal the ESP32's PIXHAWK_BAUD)

# --- Proximity sensor (first instance = PRX1_) ---
PRX1_TYPE,2               # 2 = MAVLink  (consumes OBSTACLE_DISTANCE / DISTANCE_SENSOR)
PRX1_ORIENT,0             # 0 = normal mount (do NOT change unless sensor is upside-down)
PRX1_YAW_CORR,0           # deg to rotate the whole ring if sector 0 is not vehicle-forward

# --- Upward rangefinder (the 7th VL53L0X, sent as MAVLink DISTANCE_SENSOR
#     with orientation 24 = up). RNGFND1 is reserved for the downward TF-Luna
#     (serial). VERIFY type/orientation values and whether upward avoidance
#     needs extra params on the ArduPilot rangefinder + avoidance wiki pages. ---
RNGFND2_TYPE,10           # 10 = MAVLink DISTANCE_SENSOR  (VERIFY for your firmware)
RNGFND2_ORIENT,24         # 24 = pointing up              (VERIFY for your firmware)

# --- Obstacle avoidance (bitmask: 1=Fence, 2=Proximity, 4=Beacon) ---
AVOID_ENABLE,7            # 7 = all sources; the essential bit is 2 (proximity). 3 also works.
AVOID_MARGIN,2            # m to keep from objects in GPS modes (Loiter/PosHold). Default 2.0
AVOID_BEHAVE,0            # 0 = Slide (skirt around), 1 = Stop at margin. Copter default 0
AVOID_DIST_MAX,5          # m: distance at which avoidance starts in non-GPS modes (AltHold)
AVOID_ACCEL_MAX,3         # m/s/s max accel used while avoiding (smoothing). Default 3.0
AVOID_BACKUP_SPD,0.75     # m/s max horizontal back-away speed. Default 0.75
AVOID_BACKUP_DZ,0.1       # m deadzone before backing away (raise if it oscillates). Default 0.10

# --- OPTIONAL: path planning for AUTO/GUIDED/RTL missions (leave 0 for simple avoidance) ---
# OA_TYPE,1               # 0=Disabled, 1=BendyRuler, 2=Dijkstra, 3=Dijkstra+BendyRuler
# OA_MARGIN_MAX,5         # m: ignore objects farther than this during path planning

# --- OPTIONAL: proximity tuning (frontend params keep the plain PRX_ prefix) ---
# PRX_FILT,0.25           # Hz low-pass on each boundary face (0 = disable). Default 0.25
# PRX_IGN_GND,0           # 1 = ignore returns near the ground (needs a downward rangefinder)
# PRX1_MIN,0              # m min expected range (0 = use sensor default)
# PRX1_MAX,0              # m max expected range (0 = use sensor default)
