.pio/
__pycache__/
.venv/
nohup.out

# THE DEPLOYED MODEL IS TRACKED: models/best.onnx (9.4 MB).
# It is NOT a regenerable artifact like the rest of this section. Reproducing
# it needs the exact dataset plus ~12h of GPU, and until 2026-08-13 it existed
# only on the owner's laptop and the board, so a reflash or a dead SSD would
# have destroyed it two days before the deadline. It is also the ONE file the
# board cannot obtain by git pull if it is ignored, which defeats the whole
# point of the auto-sync service. 9.4 MB against a 31 MB repo is not a cost.
# The VARIANTS below stay ignored: yolo26s (37 MB) and yolo26m (79 MB) were
# rejected on measurement and genuinely are regenerable.

# training artifacts (datasets are redownloadable; runs are reproducible)
training/.venv/
training/runs/
training/exports/
training/excluded/
training/dataset/
training/*.pt
training/train.log
# pretrained checkpoints download to CWD; variant ONNX exports are regenerable
*.pt
training/variants/
*.zip

# machine-generated param snapshots (board state, regenerate anytime;
# pixhawk_full_setup.param stays tracked: it is the hand-maintained config)
param_dumps/*
!param_dumps/pixhawk_full_setup.param

# private machine/account details
PRIVATE.md

# per-machine assistant/tooling config (launch.json etc.)
.claude/

# OS cruft. The repo goes public for judges; macOS folder-metadata blobs are
# noise at best and leak local folder state at worst.
.DS_Store
Thumbs.db


# repo-root venv. On this laptop it is a symlink to training/.venv (which also
# holds torch/ultralytics); on the Mac it is the venv itself. Same path either
# way, so the committed ./python and ./pip symlinks work on both machines.
.venv

# never track a virtualenv (was committed 2026-08-09, 1215 files / 74 MB)
.venv-tools/
