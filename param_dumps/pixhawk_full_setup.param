# =============================================================================
#  pixhawk_full_setup.param  --  MonsoonReady: FULL Pixhawk parameter set
#  Supersedes esp32_obstacle_avoidance/ardupilot_proximity.param (which covers
#  only the proximity subset). Load in QGC: Vehicle Setup > Parameters > Tools
#  > Load from file, then reboot the Pixhawk.
#
#  Lines marked VERIFY: check the exact name/value for ArduCopter 4.6.3 in the
#  onboard param list before writing; firmware variants rename some params.
#  Format NAME,VALUE. '#' lines are comments.
# =============================================================================

# --- Frame (hexa X, F550) ---
FRAME_CLASS,2             # 2 = Hexa
FRAME_TYPE,1              # 1 = X

# --- Arming & failsafes (defined explicitly; 4.7 renamed things) ---
# 4.7.0 REPLACED ARMING_CHECK with ARMING_SKIPCHK (bitmask of checks to SKIP).
# 0 = skip nothing = every prearm check runs. QGC's "Missing params:
# 1:ARMING_CHECK" popup is QGC metadata lagging this rename; ignore it.
ARMING_SKIPCHK,0
FS_THR_ENABLE,1           # 1 = RTL on RC/throttle failsafe (user policy)
# FS_THR_VALUE: leave at your configured value; must sit below the
# receiver's no-signal throttle output (bench-verify with TX off, props off)
RTL_ALT_M,15              # m return altitude (4.7 renamed + re-united); raise if trees
RTL_ALT_FINAL_M,0         # 0 = land at the end of RTL
DISARM_DELAY,10           # s auto-disarm after landing

# --- Survey speed (2026-08-17) ---
# THE NAME AND THE UNITS ARE BOTH 4.7 THINGS, and both were wrong in the
# 2026-08-17 problem scan, which asked for "WPNAV_SPEED ~3 m/s". This
# firmware has NO WPNAV_* parameters at all: a push of WPNAV_SPEED would
# have come back as a no-echo and changed nothing. The board's own dump
# (param_dumps/board_dump_20260817-*.param) carries WP_SPD, WP_SPD_UP 2.5,
# WP_SPD_DN 1.5 and WP_ACC 2.5, i.e. the renamed set in m/s and m/s2, not
# the old centimetre units. WP_SPD read 10 there, so the aircraft has been
# flying its GUIDED legs at 10 m/s while every coverage, footprint and
# motion-blur figure in PROJECT_STATE.md assumed 3.
# WHY 3 m/s WAS PICKED (2026-08-17): at 12.5 mm/px ground sampling and
# ~0.5-1 s per inference, 10 m/s leaves a 2.5 m puddle with about one frame
# on it and smears each frame roughly three times as far as 3 m/s does.
# 3 -> 2 (user, 2026-08-18), THE RING'S REACTION CEILING: with AVOID_ENABLE
# back at 7 the ring must be able to STOP the aircraft inside its ~2 m
# trusted range. Braking from 3 m/s at AVOID_ACCEL_MAX 3 needs ~1.5 m plus
# ~0.3 m of 10 Hz sensor latency = ~1.8 m: no margin. From 2 m/s the same
# sum is ~0.9 m, which leaves the AVOID_MARGIN 1 m standoff workable. The
# two params move together (PROJECT_STATE 2026-08-18): raising WP_SPD above
# 2 makes the ring cosmetic again. Blur only improves at 2; each survey leg
# takes 1.5x as long as at 3.
# VERIFY FROM THE NEXT LOG, not from this line: GUIDED position targets are
# flown by the waypoint navigation controller, which is why this parameter is
# expected to govern them, but that expectation has not been confirmed on
# this aircraft. Check the achieved ground speed in the log before trusting it.
WP_SPD,2                  # m/s survey speed (was 10; 3 for blur; 2 = ring ceiling)

# --- Flight modes + switches (reconstructed after factory reset from the
#     pre-reset QGC summary + handoff; ch5 arm, ch7 3-pos modes, ch8 kill) ---
FLTMODE_CH,7              # mode switch on ch7 (3-pos -> hits modes 1/4/6)
FLTMODE1,0                # Stabilize
FLTMODE2,0                # Stabilize
FLTMODE3,2                # AltHold
FLTMODE4,2                # AltHold
FLTMODE5,5                # Loiter
FLTMODE6,5                # Loiter
RC5_OPTION,153            # 153 = ArmDisarm (VERIFY in QGC dropdown)
RC8_OPTION,31             # 31 = Motor Emergency Stop / kill (VERIFY)
# RC6_OPTION,4            # 4 = RTL; UNCOMMENT once the spare 2-pos switch
#                           channel is confirmed (was undocumented pre-reset)

# --- Serial map (REVISED 2026-08-02: user wired TELEM1<->TELEM2 opposite to
#     the July plan: ESP32 is on TELEM1, SiK on TELEM2. Params follow the
#     wires, same rule as the 2026-07-27 SERIAL4/5 swap.) ---
SERIAL1_PROTOCOL,2        # TELEM1 = ESP32 obstacle module, MAVLink2
SERIAL1_BAUD,115          # must equal ESP32 PIXHAWK_BAUD (115200)
BRD_SER1_RTSCTS,0         # no flow-control pins wired on the ESP32 link. VERIFY name
SERIAL2_PROTOCOL,2        # TELEM2 = SiK telemetry radio, MAVLink2
SERIAL2_BAUD,57           # SiK default 57600
SERIAL4_PROTOCOL,9        # SERIAL4 = TF-Luna, Rangefinder protocol (ports swapped at build 2026-07-27: user wired Luna to #4 lines). VERIFY 9=Rangefinder
SERIAL4_BAUD,115          # TF-Luna default 115200
# SERIAL5 DISABLED 2026-08-16: the UNO Q link moved to the Pixhawk's own USB
# through the board's hub (proven: 8/8 heartbeats x3 while the camera streamed
# 600 frames). The byte-shovel is deleted and the D0/D1 + SERIAL5 wires are
# coming out; -1 makes sure a floating wire stub can never inject anything.
SERIAL5_PROTOCOL,-1       # was 2 (UNO Q MAVLink2 via STM32 shovel, retired)
SERIAL5_BAUD,115

# --- Downward rangefinder: TF-Luna on SERIAL4 (option B split cable, swapped 2026-07-27) ---
RNGFND1_TYPE,20           # 20 = Benewake TFmini/TF-Luna serial. VERIFY on rangefinder wiki
RNGFND1_ORIENT,25         # 25 = down
RNGFND1_MIN,0.2           # m. If firmware shows RNGFND1_MIN_CM instead, use 20
RNGFND1_MAX,6             # m, conservative outdoor. If RNGFND1_MAX_CM, use 600
RNGFND1_GNDCLR,0.13       # m from lens to ground when landed (4.7 name+meters). MEASURE on real airframe

# --- Upward rangefinder: 7th VL53L0X via ESP32 DISTANCE_SENSOR ---
# 10 -> 0 on 2026-08-21: ch6, the UPWARD VL53L0X, is dead (ESP32 health reads
# "up:ERR"). Its power joint was resoldered and measured good and the I2C pair
# was reconnected, so supply and bus are both ruled out; a dead chip or mux
# channel 6 remains, undiagnosed. A configured rangefinder that never reports
# is "PreArm: Rangefinder 2: No Data", which is now the ONLY new arming
# blocker. 0 removes it.
# THIS DOES NOT TOUCH THE RING. PRX1_TYPE stays 2 and AVOID_ENABLE stays 7:
# horizontal avoidance is unaffected, because AP_Proximity consumes the up
# sensor's DISTANCE_SENSOR itself and does not go through RNGFND2. The only
# thing given up is an upward sensor that is already dead.
# SET IT BACK TO 10 IN THE SAME EDIT AS THE REPAIR if ch6 is ever fixed.
RNGFND2_TYPE,0            # 0 = none (ch6 dead 2026-08-21); 10 = MAVLink
RNGFND2_ORIENT,24         # 24 = up

# --- Proximity ring: ESP32 OBSTACLE_DISTANCE ---
# PRX1_TYPE = 2 as of 2026-08-14: the refit condition is MET. comp 195 was
# heard on the bus (bench.py nodes, 5 heartbeats/20s) after the TX/RX swap at
# TELEM1 was fixed, so the ESP32 is fitted AND transmitting. PRX1_TYPE makes
# the ring an ARMING DEPENDENCY: if the ESP32 ever comes back out, set this
# to 0 EXPLICITLY (history below is why a comment-out is not enough).
# TWO MISTAKES from the 2026-08-08 parking, both worth not repeating:
#   1. It was set to 0 by hand and then this file was pushed, which put it
#      straight back to 2. A param file always beats a one-off command.
#   2. It was then COMMENTED OUT, which stopped the file re-writing 2 but
#      could not clear the 2 already on the board: a param file only asserts
#      what it CONTAINS. Anything that must be OFF has to state its off value
#      explicitly, or the file cannot bring a board to a known state.
PRX1_TYPE,2               # 2 = MAVLink (ring live 2026-08-14); 0 = none
PRX1_ORIENT,0
PRX1_YAW_CORR,0

# --- Avoidance (VL53L0X real-world range is short; margins sized to match) ---
# AVOID_ENABLE 7 -> 0 on 2026-08-14 23:30, THE NIGHT BEFORE THE SHOOT: ring
# sectors died one per test while the drone sat sealed and powered (2 dead ->
# 3 -> 4, plus the up sensor; real no-data in the stream, not radio loss),
# so flight-control influence from a degrading sensor is a mission risk.
# PRX1_TYPE STAYS 2: the ring still streams, the dashboard still shows it,
# the video can show it honestly. To re-enable avoidance at the farm: set
# AVOID_ENABLE=7 (no reboot needed for this one).
# AVOID_ENABLE 0 -> 7 on 2026-08-18 (user): the disable's stated cause is
# FIXED. The one-per-test sector deaths were the old firmware latching a
# failed channel at boot with no retry; the 2026-08-16 reflash retries DOWN
# channels every 10 s, and the TELEM1 wiring has been redone. The 08-14
# disable was conditional, not permanent, and its condition no longer holds.
# PRECONDITION before trusting it in the air: Test everything's ring row at
# 5-6/6 with the drone assembled. Dead sectors send 65535 = no-data, which
# ArduPilot IGNORES, so a degraded ring steers less, never wrongly.
# SPEED COUPLING (PROJECT_STATE 2026-08-18): braking from 3 m/s needs ~1.8 m
# against the ring's ~2 m ceiling, so avoidance cannot protect cruise at
# WP_SPD 3. Cruise is at 15 m AGL, above the obstacle field; the ring earns
# its keep in the slow low phases (descent 0.5 m/s, short cross legs).
# Ring-protected CRUISE needs WP_SPD <= 2: TRADE MADE 2026-08-18, WP_SPD,2.
AVOID_ENABLE,7            # 7 = proximity ring steers again (user 2026-08-18)
AVOID_MARGIN,1            # m stand-off in GPS modes; sensor max is ~1.2-2 m
AVOID_BEHAVE,0            # 0 = slide
AVOID_DIST_MAX,1.5        # m, non-GPS modes; must be < reliable sensor range
AVOID_ACCEL_MAX,3
AVOID_BACKUP_SPD,0.75
AVOID_BACKUP_DZ,0.1

# --- Dropper servo: MG90 on AUX OUT 1 = output channel 9 (MAIN1-8 are
#     SERVO1-8, AUX1-6 are SERVO9-14; user wired it to AUX1 on 2026-08-02,
#     superseding the provisional AUX6/ch14 assignment). FUNCTION 0 frees the
#     pin from the motor map so MAV_CMD_DO_SET_SERVO drives it; without this
#     the command is silently ignored.
#     TRAVEL measured by eye 2026-08-14 (tools/servo_jog.py): closed 560us,
#     open 1760us. MIN moved 800 -> 500 because the measured CLOSED pulse sat
#     BELOW the old MIN, and ArduPilot may clamp a commanded output to the
#     channel's MIN/MAX: with MIN 800 the gate could stop 240us short of
#     closed and dribble payload. MAX tightened 2200 -> 1800: nothing valid
#     lives above open+40us, so a typo cannot slam the linkage.
#     TRIM = the closed pulse. servo_jog deliberately leaves the gate where
#     it last was (found OPEN on the bench 2026-08-14); trim-at-closed means
#     any state in which ArduPilot emits trim on this disabled output parks
#     the gate SHUT instead of at 1500us, which is 80% of the way to open.
#     VERIFY at next battery boot: gate must sit CLOSED before arming.
#     NOTE: SERVO14_FUNCTION/MIN/MAX were pushed to the board on 2026-08-02
#     before the channel was known. They are harmless (FUNCTION 0 = the output
#     is simply not driven by anything) and are left alone rather than
#     "cleaned up", since ch14 drives nothing either way. ---
SERVO9_FUNCTION,0
# 500/560 are BELOW the 800-2200 us range ArduPilot documents for SERVOn_MIN
# and _TRIM, and that is correct here, not an oversight (re-verified
# 2026-08-16 after an audit flagged it): with FUNCTION=0 (k_none),
# MAV_CMD_DO_SET_SERVO writes the raw pulse straight through
# (AP_ServoRelayEvents.cpp do_set_servo -> SRV_Channel::set_output_pwm,
# no constrain), so the documented range is GCS slider metadata, not
# enforcement. Raising MIN to 800 would not make anything safer; it would
# only misdescribe the gate, whose measured closed position is 500 us.
SERVO9_MIN,500
SERVO9_MAX,1800
# TRIM = the CLOSED position, so an output that emits trim before the first
# DO_SET_SERVO parks the gate SHUT. Moved 560 -> 500 on 2026-08-22 when the
# hole was enlarged and closed moved to 500; leaving it at 560 would have
# parked the gate about 5% open at boot and leaked granules on the pad.
SERVO9_TRIM,500

# --- Guided safety (UNO Q command link watchdog) ---
GUID_TIMEOUT,3            # s without new commands -> stop and hover. VERIFY name

# --- Harmonic notch (set REF after the LOADED hover; see procedure) ---
INS_ACCEL_FILTER,10       # Hz accel LPF
INS_HNTCH_ENABLE,1        # reboot to expose sub-params
INS_HNTCH_MODE,1          # 1 = throttle-based (3 = ESC telemetry if BLHeli path adopted)
INS_HNTCH_REF,0.30        # PLACEHOLDER: set to learned MOT_THST_HOVER from a LOADED hover log
INS_HNTCH_FREQ,80         # PLACEHOLDER: set from FFT of hover log
INS_HNTCH_BW,40           # PLACEHOLDER: ~half of FREQ
INS_LOG_BAT_MASK,1        # batch-log IMU for FFT notch tuning; set 0 after tuning

# --- Hover throttle relearn after rebuild/payload change ---
MOT_HOVER_LEARN,2         # 2 = learn and save

# --- Battery monitor (after installing NEW power module; calibrate vs multimeter) ---
BATT_MONITOR,4            # 4 = analog voltage+current. Reboot, then calibrate
# Pack size, 3S 8000mAh (Build Log). Added to this file 2026-08-08: it had
# only ever been typed into QGC by hand, so a push_params run would not have
# restored it and nothing tracked it.
#
# READ THIS BEFORE TRUSTING THE PERCENTAGE: ArduPilot's "battery remaining"
# is COULOMB COUNTING, (BATT_CAPACITY - consumed mAh) / BATT_CAPACITY, and
# consumed resets to zero at every boot. It therefore reads 100% at power-on
# no matter what the pack's real state of charge is. It is a fuel gauge that
# assumes you started with a full tank, so it is only meaningful if you
# actually take off on a full pack. The protections that do NOT depend on
# that assumption are the voltage ones below.
BATT_CAPACITY,8000
BATT_LOW_VOLT,10.8        # 3.6 V/cell -> triggers low action
BATT_CRT_VOLT,10.2        # 3.4 V/cell -> triggers critical action
BATT_FS_LOW_ACT,2         # 2 = RTL (user-confirmed policy)
BATT_FS_CRT_ACT,1         # 1 = Land
# mAh-based failsafes (added 2026-08-14, now that the current sensor is
# CALIBRATED and coulomb counting means something). Triggers fire on mAh
# REMAINING out of BATT_CAPACITY: low at 20% left (1600 of 8000, ~3.3 min of
# hover at the measured ~479 mAh/min), critical at 10%. CAVEAT, same as the
# percentage: the counter resets to "full" at every boot, so these only mean
# anything on a flight that STARTED on a full pack. On a partial recharge the
# mAh gauge reads optimistic and the VOLTAGE failsafes above are the layer
# that actually protects.
BATT_LOW_MAH,1600
BATT_CRT_MAH,800
# Sensor calibration, CAPTURED FROM THE BOARD 2026-08-14 (was QGC-only, so a
# factory reset would have silently erased the 2026-08-13 current-sensor fix).
# PERVLT 24 replaces the mis-set 90.6866 ("90A module" typed into the wrong
# QGC field) that made log 37 read 105 A for a real 28.8 A hover. Derived from
# charger-returned mAh vs counted mAh (3.68x) and sanity-checked against the
# momentum-theory 22-34 A hover band. VOLT_MULT verified against multimeter.
BATT_AMP_PERVLT,24
BATT_VOLT_MULT,10.802477

# --- RC failsafe: already configured to RTL (user-confirmed). Re-verify after
#     rebuild with a bench TX-off test (props off): FS_THR_ENABLE, FS_THR_VALUE.

# --- OLED status display (existing, verified working) ---
NTF_DISPLAY_TYPE,2

# --- Fence: flyaway backstop, ENABLED 2026-08-15 for the autonomous flight ---
# POLYGON ADDED 2026-08-16 (user): "I will set the geofence manually so that
# the drone doesnt go into any trees. The field is not a cylinder or a
# rectangle, it is a weird shape I have to draw myself." The circle stays as
# a coarse outer backstop; the hand-drawn polygon is the one that keeps the
# aircraft off the treeline. The polygon itself is NOT a parameter: it is
# uploaded as fence mission items and lives in the flight controller's own
# fence storage, so it survives reboots and is not in this file. Draw and
# push it from the dashboard (map header: Draw fence -> Push fence), or with
# uno_q/fence.py push.
#
# THE ARDUINO CANNOT OVERRIDE THIS, and that is structural rather than a
# promise. The fence lives inside the Pixhawk, downstream of every command the
# companion sends; the companion only ever asks for a position or a velocity
# and ArduPilot decides what to do with the request. Audited 2026-08-15: the
# whole outbound vocabulary of uno_q/ is heartbeat, command_long (DO_SET_MODE,
# COMPONENT_ARM_DISARM, NAV_TAKEOFF, DO_SET_SERVO, SET_MESSAGE_INTERVAL) and
# the two SET_POSITION_TARGET messages. There is NO PARAM_SET and NO
# MAV_CMD_DO_FENCE_ENABLE in the flight path at all, so no code on the board
# can disable, resize, or breach-exempt the fence. Parameter writing lives
# only in tools/parameters.py, which is run by hand from the laptop.
# ON BREACH the action below changes the FLIGHT MODE. mission.py sees a mode
# that is not GUIDED and goes STANDDOWN, which stops it commanding and does
# NOT re-command a mode (STANDDOWN is deliberately excluded from the
# end_mode branch), so the fence's RTL is left alone to run.
FENCE_ENABLE,1
# 1 = max altitude, 2 = circle, 4 = polygon+circle inclusion/exclusion areas
# (verified in the aircraft's own firmware: AC_Fence.h:15-18, Copter-4.7.0).
# 7 = all three, chosen 2026-08-16 when the hand-drawn polygon replaced the
# cylinder as the real boundary.
#
# READ THIS BEFORE THE NEXT FLIGHT (tested in SITL 2026-08-16, and the result
# was the OPPOSITE of what the source reads like at a glance): setting bit 2
# with NO polygon uploaded does NOT block arming. AC_Fence's polygon prearm
# check asks _poly_loader.loaded(), and loaded() is `_load_time_ms != 0`
# (AC_PolyFence_loader.h:165) - an EMPTY fence loads successfully, so the
# check passes and the aircraft arms with no polygon boundary in force at
# all. Proven live: FENCE_TYPE=7, FENCE_ENABLE=1, fence cleared to 0 corners,
# "Arming motors", no PreArm complaint.
# So the failure mode is SILENT, and the guard has to be ours: the
# dashboard's self-test reads the fence back out of the aircraft and FAILS
# the 'fence' check when the Pixhawk holds no polygon, or holds a different
# one from the one drawn. Field order stays: push params, draw the fence,
# Push fence, then check arming.
FENCE_TYPE,7
FENCE_ACTION,1            # 1 = RTL (falls back to LAND if RTL is impossible)
FENCE_ALT_MAX,30          # m. Survey is 15 m, RTL_ALT_M is 15, so 2x margin.
FENCE_RADIUS,100          # m FROM HOME (= where it arms), not from the plot.
                          # Survey reaches ~25 m from its start corner; 100 m
                          # covers the walk from the ground station to the
                          # start corner and still contains a flyaway.
FENCE_MARGIN,2            # m of warning before the breach action fires
# NOTE (updated 2026-08-18, AVOID_ENABLE now 7): bit 1 of AVOID_ENABLE is
# FENCE avoidance, so the aircraft now also SLOWS TO A STOP at the boundary
# instead of only breaching and turning around. The fence FAILSAFE above is
# independent of it and remains the layer that actually protects; the soft
# stop in front of it is new behaviour and UNTESTED in the air.

# --- RECOMMENDED notch upgrade: in-flight gyro FFT (INS_HNTCH_MODE 4).
#     DEAD END (2026-07-25, hwdef-verified): 6-motor DShot/bdshot impossible on
#     Pixhawk1-bdshot, AUX5-6 are NODMA ("Chan 13 to 14 PWM failed no DMA" boot
#     msg); motors STAY on MAIN PWM. This build HAS HAL_GYROFFT_ENABLED, so the
#     FFT notch gives dynamic RPM-quality tracking with zero wiring instead.
#     Start with throttle mode above for the first hovers; then switch:
# FFT_ENABLE,1            # reboot to expose FFT_ sub-params
# FFT_MINHZ,50            # lower bound of tracked peak. VERIFY sensible for 1045 props
# FFT_MAXHZ,200           # upper bound
# INS_HNTCH_MODE,4        # 4 = in-flight FFT tracking
# INS_HNTCH_REF,1
