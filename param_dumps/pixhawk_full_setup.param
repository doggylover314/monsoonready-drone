# =============================================================================
#  pixhawk_full_setup.param  --  MonsoonReady: FULL Pixhawk parameter set
#  Supersedes esp32_obstacle_avoidance/ardupilot_proximity.param (which covers
#  only the proximity subset). Load in QGC: Vehicle Setup > Parameters > Tools
#  > Load from file, then reboot the Pixhawk.
#
#  Lines marked VERIFY: check the exact name/value for ArduCopter 4.6.3 in the
#  onboard param list before writing; firmware variants rename some params.
#  Format NAME,VALUE. '#' lines are comments.
# =============================================================================

# --- Frame (hexa X, F550) ---
FRAME_CLASS,2             # 2 = Hexa
FRAME_TYPE,1              # 1 = X

# --- Arming & failsafes (defined explicitly; 4.7 renamed things) ---
# 4.7.0 REPLACED ARMING_CHECK with ARMING_SKIPCHK (bitmask of checks to SKIP).
# 0 = skip nothing = every prearm check runs. QGC's "Missing params:
# 1:ARMING_CHECK" popup is QGC metadata lagging this rename; ignore it.
ARMING_SKIPCHK,0
FS_THR_ENABLE,1           # 1 = RTL on RC/throttle failsafe (user policy)
# FS_THR_VALUE: leave at your configured value; must sit below the
# receiver's no-signal throttle output (bench-verify with TX off, props off)
RTL_ALT_M,15              # m return altitude (4.7 renamed + re-united); raise if trees
RTL_ALT_FINAL_M,0         # 0 = land at the end of RTL
DISARM_DELAY,10           # s auto-disarm after landing

# --- Flight modes + switches (reconstructed after factory reset from the
#     pre-reset QGC summary + handoff; ch5 arm, ch7 3-pos modes, ch8 kill) ---
FLTMODE_CH,7              # mode switch on ch7 (3-pos -> hits modes 1/4/6)
FLTMODE1,0                # Stabilize
FLTMODE2,0                # Stabilize
FLTMODE3,2                # AltHold
FLTMODE4,2                # AltHold
FLTMODE5,5                # Loiter
FLTMODE6,5                # Loiter
RC5_OPTION,153            # 153 = ArmDisarm (VERIFY in QGC dropdown)
RC8_OPTION,31             # 31 = Motor Emergency Stop / kill (VERIFY)
# RC6_OPTION,4            # 4 = RTL; UNCOMMENT once the spare 2-pos switch
#                           channel is confirmed (was undocumented pre-reset)

# --- Serial map (REVISED 2026-08-02: user wired TELEM1<->TELEM2 opposite to
#     the July plan: ESP32 is on TELEM1, SiK on TELEM2. Params follow the
#     wires, same rule as the 2026-07-27 SERIAL4/5 swap.) ---
SERIAL1_PROTOCOL,2        # TELEM1 = ESP32 obstacle module, MAVLink2
SERIAL1_BAUD,115          # must equal ESP32 PIXHAWK_BAUD (115200)
BRD_SER1_RTSCTS,0         # no flow-control pins wired on the ESP32 link. VERIFY name
SERIAL2_PROTOCOL,2        # TELEM2 = SiK telemetry radio, MAVLink2
SERIAL2_BAUD,57           # SiK default 57600
SERIAL4_PROTOCOL,9        # SERIAL4 = TF-Luna, Rangefinder protocol (ports swapped at build 2026-07-27: user wired Luna to #4 lines). VERIFY 9=Rangefinder
SERIAL4_BAUD,115          # TF-Luna default 115200
SERIAL5_PROTOCOL,2        # SERIAL5 = UNO Q, MAVLink2 (swap upside: SERIAL5 boot noise now hits junk-tolerant pymavlink, not the Luna)
SERIAL5_BAUD,115

# --- Downward rangefinder: TF-Luna on SERIAL4 (option B split cable, swapped 2026-07-27) ---
RNGFND1_TYPE,20           # 20 = Benewake TFmini/TF-Luna serial. VERIFY on rangefinder wiki
RNGFND1_ORIENT,25         # 25 = down
RNGFND1_MIN,0.2           # m. If firmware shows RNGFND1_MIN_CM instead, use 20
RNGFND1_MAX,6             # m, conservative outdoor. If RNGFND1_MAX_CM, use 600
RNGFND1_GNDCLR,0.13       # m from lens to ground when landed (4.7 name+meters). MEASURE on real airframe

# --- Upward rangefinder: 7th VL53L0X via ESP32 DISTANCE_SENSOR ---
RNGFND2_TYPE,10           # 10 = MAVLink
RNGFND2_ORIENT,24         # 24 = up

# --- Proximity ring: ESP32 OBSTACLE_DISTANCE ---
# PRX1_TYPE = 2 as of 2026-08-14: the refit condition is MET. comp 195 was
# heard on the bus (bench.py nodes, 5 heartbeats/20s) after the TX/RX swap at
# TELEM1 was fixed, so the ESP32 is fitted AND transmitting. PRX1_TYPE makes
# the ring an ARMING DEPENDENCY: if the ESP32 ever comes back out, set this
# to 0 EXPLICITLY (history below is why a comment-out is not enough).
# TWO MISTAKES from the 2026-08-08 parking, both worth not repeating:
#   1. It was set to 0 by hand and then this file was pushed, which put it
#      straight back to 2. A param file always beats a one-off command.
#   2. It was then COMMENTED OUT, which stopped the file re-writing 2 but
#      could not clear the 2 already on the board: a param file only asserts
#      what it CONTAINS. Anything that must be OFF has to state its off value
#      explicitly, or the file cannot bring a board to a known state.
PRX1_TYPE,2               # 2 = MAVLink (ring live 2026-08-14); 0 = none
PRX1_ORIENT,0
PRX1_YAW_CORR,0

# --- Avoidance (VL53L0X real-world range is short; margins sized to match) ---
AVOID_ENABLE,7            # bit 2 (proximity) is the essential one
AVOID_MARGIN,1            # m stand-off in GPS modes; sensor max is ~1.2-2 m
AVOID_BEHAVE,0            # 0 = slide
AVOID_DIST_MAX,1.5        # m, non-GPS modes; must be < reliable sensor range
AVOID_ACCEL_MAX,3
AVOID_BACKUP_SPD,0.75
AVOID_BACKUP_DZ,0.1

# --- Dropper servo: MG90 on AUX OUT 1 = output channel 9 (MAIN1-8 are
#     SERVO1-8, AUX1-6 are SERVO9-14; user wired it to AUX1 on 2026-08-02,
#     superseding the provisional AUX6/ch14 assignment). FUNCTION 0 frees the
#     pin from the motor map so MAV_CMD_DO_SET_SERVO drives it; without this
#     the command is silently ignored.
#     TRAVEL measured by eye 2026-08-14 (tools/servo_jog.py): closed 560us,
#     open 1760us. MIN moved 800 -> 500 because the measured CLOSED pulse sat
#     BELOW the old MIN, and ArduPilot may clamp a commanded output to the
#     channel's MIN/MAX: with MIN 800 the gate could stop 240us short of
#     closed and dribble payload. MAX tightened 2200 -> 1800: nothing valid
#     lives above open+40us, so a typo cannot slam the linkage.
#     TRIM = the closed pulse. servo_jog deliberately leaves the gate where
#     it last was (found OPEN on the bench 2026-08-14); trim-at-closed means
#     any state in which ArduPilot emits trim on this disabled output parks
#     the gate SHUT instead of at 1500us, which is 80% of the way to open.
#     VERIFY at next battery boot: gate must sit CLOSED before arming.
#     NOTE: SERVO14_FUNCTION/MIN/MAX were pushed to the board on 2026-08-02
#     before the channel was known. They are harmless (FUNCTION 0 = the output
#     is simply not driven by anything) and are left alone rather than
#     "cleaned up", since ch14 drives nothing either way. ---
SERVO9_FUNCTION,0
SERVO9_MIN,500
SERVO9_MAX,1800
SERVO9_TRIM,560

# --- Guided safety (UNO Q command link watchdog) ---
GUID_TIMEOUT,3            # s without new commands -> stop and hover. VERIFY name

# --- Harmonic notch (set REF after the LOADED hover; see procedure) ---
INS_ACCEL_FILTER,10       # Hz accel LPF
INS_HNTCH_ENABLE,1        # reboot to expose sub-params
INS_HNTCH_MODE,1          # 1 = throttle-based (3 = ESC telemetry if BLHeli path adopted)
INS_HNTCH_REF,0.30        # PLACEHOLDER: set to learned MOT_THST_HOVER from a LOADED hover log
INS_HNTCH_FREQ,80         # PLACEHOLDER: set from FFT of hover log
INS_HNTCH_BW,40           # PLACEHOLDER: ~half of FREQ
INS_LOG_BAT_MASK,1        # batch-log IMU for FFT notch tuning; set 0 after tuning

# --- Hover throttle relearn after rebuild/payload change ---
MOT_HOVER_LEARN,2         # 2 = learn and save

# --- Battery monitor (after installing NEW power module; calibrate vs multimeter) ---
BATT_MONITOR,4            # 4 = analog voltage+current. Reboot, then calibrate
# Pack size, 3S 8000mAh (Build Log). Added to this file 2026-08-08: it had
# only ever been typed into QGC by hand, so a push_params run would not have
# restored it and nothing tracked it.
#
# READ THIS BEFORE TRUSTING THE PERCENTAGE: ArduPilot's "battery remaining"
# is COULOMB COUNTING, (BATT_CAPACITY - consumed mAh) / BATT_CAPACITY, and
# consumed resets to zero at every boot. It therefore reads 100% at power-on
# no matter what the pack's real state of charge is. It is a fuel gauge that
# assumes you started with a full tank, so it is only meaningful if you
# actually take off on a full pack. The protections that do NOT depend on
# that assumption are the voltage ones below.
BATT_CAPACITY,8000
BATT_LOW_VOLT,10.8        # 3.6 V/cell -> triggers low action
BATT_CRT_VOLT,10.2        # 3.4 V/cell -> triggers critical action
BATT_FS_LOW_ACT,2         # 2 = RTL (user-confirmed policy)
BATT_FS_CRT_ACT,1         # 1 = Land
# mAh-based failsafes (added 2026-08-14, now that the current sensor is
# CALIBRATED and coulomb counting means something). Triggers fire on mAh
# REMAINING out of BATT_CAPACITY: low at 20% left (1600 of 8000, ~3.3 min of
# hover at the measured ~479 mAh/min), critical at 10%. CAVEAT, same as the
# percentage: the counter resets to "full" at every boot, so these only mean
# anything on a flight that STARTED on a full pack. On a partial recharge the
# mAh gauge reads optimistic and the VOLTAGE failsafes above are the layer
# that actually protects.
BATT_LOW_MAH,1600
BATT_CRT_MAH,800
# Sensor calibration, CAPTURED FROM THE BOARD 2026-08-14 (was QGC-only, so a
# factory reset would have silently erased the 2026-08-13 current-sensor fix).
# PERVLT 24 replaces the mis-set 90.6866 ("90A module" typed into the wrong
# QGC field) that made log 37 read 105 A for a real 28.8 A hover. Derived from
# charger-returned mAh vs counted mAh (3.68x) and sanity-checked against the
# momentum-theory 22-34 A hover band. VOLT_MULT verified against multimeter.
BATT_AMP_PERVLT,24
BATT_VOLT_MULT,10.802477

# --- RC failsafe: already configured to RTL (user-confirmed). Re-verify after
#     rebuild with a bench TX-off test (props off): FS_THR_ENABLE, FS_THR_VALUE.

# --- OLED status display (existing, verified working) ---
NTF_DISPLAY_TYPE,2

# --- Fence (user: to be configured later; flyaway backstop) ---
# FENCE_ENABLE,1
# FENCE_TYPE,7            # bitmask: alt + circle + polygon. VERIFY bit values
# FENCE_ACTION,1          # 1 = RTL
# FENCE_ALT_MAX,30        # m
# FENCE_RADIUS,100        # m

# --- RECOMMENDED notch upgrade: in-flight gyro FFT (INS_HNTCH_MODE 4).
#     DEAD END (2026-07-25, hwdef-verified): 6-motor DShot/bdshot impossible on
#     Pixhawk1-bdshot, AUX5-6 are NODMA ("Chan 13 to 14 PWM failed no DMA" boot
#     msg); motors STAY on MAIN PWM. This build HAS HAL_GYROFFT_ENABLED, so the
#     FFT notch gives dynamic RPM-quality tracking with zero wiring instead.
#     Start with throttle mode above for the first hovers; then switch:
# FFT_ENABLE,1            # reboot to expose FFT_ sub-params
# FFT_MINHZ,50            # lower bound of tracked peak. VERIFY sensible for 1045 props
# FFT_MAXHZ,200           # upper bound
# INS_HNTCH_MODE,4        # 4 = in-flight FFT tracking
# INS_HNTCH_REF,1
